{
  "name": "dsh-knowledge-sqlite",
  "version": "0.1.0",
  "description": "Cross-session knowledge for DeepSeek Harness: ctx.knowledge service + knowledge_* tools, SQLite FTS5 trigram retrieval (CJK substring) with L1 query expansion. V1.11 contract (write/update/search/list/delete + budget + events + error codes).",
  "license": "MIT",
  "author": "NinjaSln-labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NinjaSln-labs/dsh-knowledge-sqlite.git"
  },
  "homepage": "https://github.com/NinjaSln-labs/dsh-knowledge-sqlite#readme",
  "bugs": {
    "url": "https://github.com/NinjaSln-labs/dsh-knowledge-sqlite/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": ["<client half 需要的宿主 UI 包，如 @deepseek-ai/dsh-client-runtime>"],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/verify.mjs",
    "check:deploy": "node scripts/check-deploy.mjs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-<用到的宿主包>": "^0.1.2-alpha.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-<可选宿主包>": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^24",
    "@deepseek-ai/dsh-<用到的宿主包>": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-<运行时可达的其他宿主包>": "^0.1.2-alpha.4",
    "typescript": "^5.7.0"
  }
}
