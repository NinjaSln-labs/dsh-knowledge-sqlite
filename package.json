{
  "name": "dsh-knowledge-sqlite",
  "description": "Cross-session knowledge for DeepSeek Harness: ctx.knowledge service + knowledge_* tools, SQLite FTS5 trigram retrieval (CJK substring) with L1 query expansion. V1.11 contract (write/update/search/list/delete + budget + events + error codes).",
  "version": "0.1.6",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "knowledge-base",
    "cross-session",
    "sqlite",
    "fts5",
    "trigram",
    "full-text-search",
    "chinese",
    "cjk",
    "query-expansion",
    "retrieval"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit || true",
    "test": "vitest run",
    "check:deploy": "node scripts/check-deploy.mjs"
  },
  "license": "MIT",
  "author": {
    "name": "ninjasln",
    "url": "https://github.com/NinjaSln-labs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NinjaSln-labs/dsh-knowledge-sqlite.git"
  },
  "homepage": "https://github.com/NinjaSln-labs/dsh-knowledge-sqlite#readme",
  "bugs": {
    "url": "https://github.com/NinjaSln-labs/dsh-knowledge-sqlite/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent-default-model": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-llm": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-session": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-tools": "^0.1.2-alpha.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent-default-model": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-api-remotes": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-fs-local": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-llm": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-session": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-tools": "^0.1.2-alpha.4",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@deepseek-ai/dsh-scope": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-util-values": "^0.1.2-alpha.5"
  }
}
